{
  "name": "Trip Keeper",
  "short_name": "Trip Keeper",
  "description": "A private, offline-first travel organizer.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F6F5F1",
  "theme_color": "#0F766E",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add a booking",
      "short_name": "Booking",
      "description": "Add a flight, hotel or any document",
      "url": "./booking",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Add an expense",
      "short_name": "Expense",
      "description": "Log what you spent",
      "url": "./expense",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
